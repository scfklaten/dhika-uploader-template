---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => {
	const dateOrder = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	// Jika tanggal sama, slug artikel baru memiliki timestamp lebih besar.
	return dateOrder || b.id.localeCompare(a.id);
});
const latestPosts = posts.slice(0, 3);
const title = SITE_TITLE;
const description = 'Koleksi dan update Jalak Suren dari Dhika Jalak Suren Bali. Lihat informasi burung terbaru dan hubungi kami untuk ketersediaan.';
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<img class="hero-image" src="/IMG-20261120-WA0024.jpg" alt="Gambar sementara untuk koleksi Dhika Jalak Suren Bali" fetchpriority="high" />
				<div class="hero-content">
					<p class="eyebrow">KOLEKSI • INFORMASI • UPDATE</p>
					<h1 id="hero-title">Dhika Jalak Suren Bali</h1>
					<p class="hero-description">Temukan informasi dan update koleksi Jalak Suren. Untuk memastikan ketersediaan burung dan informasi harga terbaru, silakan hubungi kami secara langsung.</p>
					<a class="primary-button" href="/burung/">Lihat Koleksi Burung <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section class="latest section" aria-labelledby="latest-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">KABAR TERBARU</p>
						<h2 id="latest-title">Update Koleksi Burung</h2>
						<p class="section-description">Lihat postingan dan koleksi burung yang baru ditambahkan.</p>
					</div>
					<a class="text-link desktop-link" href="/burung/">Lihat semua update <span aria-hidden="true">→</span></a>
				</div>

				{latestPosts.length > 0 ? (
					<div class="post-grid">
						{latestPosts.map((post) => (
							<a class="post-card" href={`/burung/${post.id}/`}>
								<img src={post.data.heroImage || '/blog-placeholder-2.jpg'} alt={post.data.title} loading="lazy" />
								<div class="post-card-content">
									<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="card-link">Lihat detail <span aria-hidden="true">→</span></span>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="empty-state">
						<p>Update koleksi akan ditampilkan di sini setelah postingan burung ditambahkan.</p>
						<a class="text-link" href="/burung/">Kunjungi halaman Update <span aria-hidden="true">→</span></a>
					</div>
				)}
				<a class="text-link mobile-link" href="/burung/">Lihat semua update <span aria-hidden="true">→</span></a>
			</section>

			<section class="quick-links section" aria-label="Jelajahi website">
				<a class="quick-card" href="/burung/">
					<span class="quick-icon" aria-hidden="true">🐦</span>
					<span class="quick-card-copy">
						<strong>Koleksi & Update</strong>
						<span>Lihat postingan burung dan informasi koleksi terbaru.</span>
					</span>
					<span class="quick-arrow" aria-hidden="true">→</span>
				</a>
				<a class="quick-card" href="/info/">
					<span class="quick-icon" aria-hidden="true">ℹ️</span>
					<span class="quick-card-copy">
						<strong>Profil & Informasi</strong>
						<span>Kenali Dhika Jalak Suren Bali dan temukan informasi kontak.</span>
					</span>
					<span class="quick-arrow" aria-hidden="true">→</span>
				</a>
			</section>

			<section class="hero hero2129" aria-labelledby="hero-title">
				<img class="hero-image hero-image21" src="/IMG-20261120-WA0021.jpg" alt="Gambar sementara untuk koleksi Dhika Jalak Suren Bali" fetchpriority="high" />
                <img class="hero-image hero-image29" src="/IMG-20261120-WA0029.jpg" alt="Gambar sementara untuk koleksi Dhika Jalak Suren Bali" fetchpriority="high" />
			</section>

			<section class="contact section" aria-labelledby="contact-title">
				<div>
					<p class="eyebrow">HUBUNGI KAMI</p>
					<h2 id="contact-title">Tertarik dengan koleksi kami?</h2>
					<p>Stok dan harga dapat berubah. Silakan hubungi kami untuk memastikan informasi terbaru.</p>
				</div>
				<a class="whatsapp-button" href="https://wa.me/6287723457380?text=Halo%20Dhika%20Jalak%20Suren%20Bali%2C%20saya%20ingin%20bertanya%20tentang%20koleksi%20burung." target="_blank" rel="noopener noreferrer">
					<span aria-hidden="true">✆</span> Hubungi via WhatsApp
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(100% - 2rem, 1100px);
		margin: 0 auto;
		padding: 2rem 0 3.5rem;
	}

	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 390px;
		overflow: hidden;
		border-radius: 18px;
		background: #173d2d;
		color: #fff;
		isolation: isolate;
	}

	.hero2129 {
		margin-top: 4rem;
	}

	.hero::after {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(90deg, rgba(8, 35, 24, .88) 0%, rgba(8, 35, 24, .62) 52%, rgba(8, 35, 24, .12) 100%);
		content: '';
	}

	.hero-image {
		position: absolute;
		z-index: -2;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 45%;
	}

     .hero-image29 { z-index: 0; }
     .hero-image21 { z-index: 0; object-position: center 30%; }

	.hero-content {
		max-width: 650px;
		padding: clamp(2rem, 6vw, 4.5rem);
	}

	.eyebrow {
		margin: 0 0 .65rem;
		color: #159957;
		font-size: .76rem;
		font-weight: 800;
		letter-spacing: .14em;
	}

	.hero .eyebrow { color: #b9f2d0; }

	h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(2.2rem, 6vw, 3.8rem);
		line-height: 1.08;
	}

	.hero-description {
		max-width: 540px;
		margin: 1rem 0 1.6rem;
		color: rgba(255,255,255,.92);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.primary-button, .whatsapp-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: .6rem;
		padding: .85rem 1.25rem;
		border-radius: 999px;
		background: #159957;
		color: #fff;
		font-weight: 800;
		text-decoration: none;
		transition: background .2s ease, transform .2s ease;
	}

	.primary-button:hover, .whatsapp-button:hover {
		background: #117b47;
		transform: translateY(-2px);
	}

	.section { margin-top: 4rem; }

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.4rem;
	}

	h2 {
		margin: 0;
		color: #202923;
		font-size: clamp(1.55rem, 3vw, 2rem);
		line-height: 1.2;
	}

	.section-description {
		margin: .5rem 0 0;
		color: #65716a;
		line-height: 1.6;
	}

	.text-link, .card-link {
		color: #13834c;
		font-weight: 800;
		text-decoration: none;
	}

	.text-link:hover, .card-link:hover { text-decoration: underline; text-underline-offset: 3px; }

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.post-card {
		overflow: hidden;
		border: 1px solid #e6ece8;
		border-radius: 14px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		transition: transform .2s ease, box-shadow .2s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px rgba(20, 60, 38, .1);
	}

	.post-card > img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.post-card-content { padding: 1.1rem; }

	.post-date {
		margin: 0 0 .45rem;
		color: #718078;
		font-size: .82rem;
	}

	.post-card h3 {
		margin: 0 0 .55rem;
		color: #202923;
		font-size: 1.15rem;
		line-height: 1.35;
	}

	.post-card-content > p:not(.post-date) {
		display: -webkit-box;
		overflow: hidden;
		margin: 0 0 .9rem;
		color: #65716a;
		font-size: .92rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.card-link { font-size: .9rem; }

	.empty-state {
		padding: 1.5rem;
		border: 1px dashed #cbd8cf;
		border-radius: 12px;
		background: #f7faf8;
		text-align: center;
	}

	.empty-state p { margin: 0 0 .7rem; color: #65716a; }

	.mobile-link { display: none; }

	.quick-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.quick-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.35rem;
		border: 1px solid #e6ece8;
		border-radius: 14px;
		background: #f7faf8;
		color: inherit;
		text-decoration: none;
		transition: border-color .2s ease, transform .2s ease;
	}

	.quick-card:hover { transform: translateY(-2px); border-color: #159957; }

	.quick-icon {
		display: grid;
		flex: 0 0 48px;
		width: 48px;
		height: 48px;
		place-items: center;
		border-radius: 12px;
		background: #e4f4ea;
		font-size: 1.4rem;
	}

	.quick-card-copy { display: grid; gap: .3rem; }
	.quick-card-copy strong { color: #202923; }
	.quick-card-copy > span { color: #65716a; font-size: .9rem; line-height: 1.5; }
	.quick-arrow { margin-left: auto; color: #159957; font-size: 1.3rem; }

	.contact {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 2rem;
		border-radius: 16px;
		background: #eef7f1;
	}

	.contact p:last-child {
		margin: .6rem 0 0;
		color: #65716a;
		line-height: 1.6;
	}

	.whatsapp-button { flex: 0 0 auto; }

   @media (min-width: 720px) { .hero-image29 { display: none; } }

	@media (max-width: 720px) {
		main { width: min(100% - 1.25rem, 1100px); padding: 1rem 0 2.5rem; }
		.hero { min-height: 410px; border-radius: 14px; }
		.hero::after { background: linear-gradient(90deg, rgba(8, 35, 24, .84), rgba(8, 35, 24, .42)); }
		.hero-content { padding: 1.6rem; }
		.hero-description { font-size: .98rem; }
		.section { margin-top: 2.8rem; }
		.section-heading { align-items: start; }
		.desktop-link { display: none; }
		.mobile-link { display: inline-block; margin-top: 1.2rem; }
		.post-grid { grid-template-columns: 1fr; gap: 1rem; }
		.post-card { display: grid; grid-template-columns: 38% minmax(0, 1fr); }
		.post-card > img { height: 100%; min-height: 150px; aspect-ratio: auto; }
		.post-card-content { padding: .85rem; }
		.post-card h3 { font-size: 1rem; }
		.post-card-content > p:not(.post-date) { font-size: .84rem; }
		.quick-links { grid-template-columns: 1fr; }
		.contact { align-items: stretch; flex-direction: column; gap: 1.2rem; padding: 1.4rem; }
		.whatsapp-button { align-self: flex-start; }
         .hero-image21 { display: none; }
	}

	@media (max-width: 380px) {
		.post-card { grid-template-columns: 1fr; }
		.post-card > img { height: auto; aspect-ratio: 16 / 9; }
	}
</style>
