---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/burung">Update</HeaderLink>
			<HeaderLink href="/info">Info</HeaderLink>
		</div>
		<div class="social-links" aria-label="Media sosial dan akses pengelola">
			<a href="https://www.facebook.com/jalak.suren.bali" target="_blank" rel="noopener noreferrer" aria-label="Facebook Dhika Jalak Suren Bali">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.1H7v3.2h2.8V21h3.7Z"/></svg>
			</a>
			<a href="https://www.tiktok.com/@dhika.jalak.suren.bali" target="_blank" rel="noopener noreferrer" aria-label="TikTok Dhika Jalak Suren Bali">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M19.6 8.2a7.2 7.2 0 0 1-4.2-1.4v7.1a6.1 6.1 0 1 1-5.3-6.1v3.7a2.5 2.5 0 1 0 1.7 2.4V2.5h3.6c.2 2.1 1.8 3.8 4.2 4v1.7Z"/></svg>
			</a>
			<a href="https://www.instagram.com/ud.dhikajalaksuren/" target="_blank" rel="noopener noreferrer" aria-label="Instagram UD Dhika Jalak Suren">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="6.5" r="1.2" fill="currentColor"/></svg>
			</a>
			<button class="admin-login" id="admin-login-toggle" type="button" aria-label="Login pengelola" title="Login pengelola">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="23" height="23"><rect x="4.5" y="10" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1.2" fill="currentColor"/></svg>
			</button>
		</div>
	</nav>
</header>
<dialog id="admin-login-dialog" class="admin-dialog">
  <form id="admin-login-form" method="dialog">
    <h2>Login Pengelola</h2>
    <p>Masukkan password untuk mengelola website.</p>
    <label for="admin-password">Password</label>
    <input id="admin-password" name="password" type="password" autocomplete="current-password" required maxlength="256" />
    <p id="admin-login-message" role="status" aria-live="polite"></p>
    <div class="admin-dialog-actions">
      <button type="button" id="admin-login-cancel">Batal</button>
      <button type="submit" id="admin-login-submit">Masuk</button>
    </div>
  </form>
</dialog>
<script is:inline>
(() => {
  const toggle = document.querySelector('#admin-login-toggle');
  const dialog = document.querySelector('#admin-login-dialog');
  const form = document.querySelector('#admin-login-form');
  const password = document.querySelector('#admin-password');
  const message = document.querySelector('#admin-login-message');
  const submit = document.querySelector('#admin-login-submit');
  const cancel = document.querySelector('#admin-login-cancel');
  if (!toggle || !dialog || !form) return;
  const showAdmin = (active) => {
    toggle.setAttribute('aria-label', active ? 'Buka menu pengelola' : 'Login pengelola');
    toggle.title = active ? 'Menu pengelola' : 'Login pengelola';
    toggle.innerHTML = active
      ? '<svg viewBox="0 0 24 24" aria-hidden="true" width="23" height="23"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'
      : '<svg viewBox="0 0 24 24" aria-hidden="true" width="23" height="23"><rect x="4.5" y="10" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1.2" fill="currentColor"/></svg>';
    toggle.dataset.authenticated = active ? 'true' : 'false';
  };
  fetch('/api/auth/session', { credentials: 'same-origin' })
    .then(r => r.json()).then(data => showAdmin(!!data.authenticated)).catch(() => showAdmin(false));
  toggle.addEventListener('click', () => {
    if (toggle.dataset.authenticated === 'true') {
      window.location.href = '/post/';
      return;
    }
    message.textContent = '';
    password.value = '';
    dialog.showModal();
    password.focus();
  });
  cancel.addEventListener('click', () => dialog.close());
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submit.disabled = true;
    message.textContent = 'Memeriksa password…';
    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ password: password.value })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Login gagal.');
      showAdmin(true);
      dialog.close();
      window.location.href = '/post/';
    } catch (error) {
      message.textContent = error.message || 'Tidak dapat login.';
    } finally {
      submit.disabled = false;
    }
  });
})();
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(to left, #159957, #155799);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
        color: #ffffff;
	}
	h2 { margin: 0; font-size: 1.5em; color: #ffffff;}
	h2 a, h2 a.active { text-decoration: none; }
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #ffc107;
	}
	.social-links, .social-links a { display: flex; }
	.social-links { align-items: center; gap: 0.35em; }
	.social-links a { padding: 0.5em; }
	.social-links a:hover { color: #ffc107; }
	.admin-login {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		margin-left: 0.15em;
		padding: 0;
		border: 1px solid rgba(255,255,255,.42);
		border-radius: 50%;
		background: rgba(255,255,255,.10);
		color: #fff;
		cursor: not-allowed;
		opacity: .82;
	}
	.admin-login:disabled { opacity: .82; }

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			justify-content: center;
			gap: 0.15rem;
			padding: 2em 0 0.35rem;
		}
		nav h2 {
			width: 100%;
			text-align: center;
            font-size: 24px;
		}
		.internal-links {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
		}
		nav a {
			padding: 0.7em 0.65em;
		}
		.social-links {
			display: flex;
			justify-content: center;
			gap: 0.5em;
		}
		.social-links a {
			padding: 1em 0.35em;
		}
		.admin-login {
			width: 38px;
			height: 38px;
			margin-left: 0.1em;
		}
	}

  .admin-dialog { width: min(92vw, 390px); border: 0; border-radius: 16px; padding: 0; box-shadow: 0 20px 60px #0004; }
  .admin-dialog::backdrop { background: #10201899; }
  .admin-dialog form { padding: 1.5rem; }
  .admin-dialog h2 { margin: 0 0 .35rem; color: #183d2b; font-size: 1.35rem; }
  .admin-dialog p { color: #65716a; margin: 0 0 1rem; }
  .admin-dialog label { display: block; margin-bottom: .4rem; font-weight: 700; color: #263b31; }
  .admin-dialog input { width: 100%; box-sizing: border-box; padding: .8rem; border: 1px solid #cbd5ce; border-radius: 9px; font: inherit; }
  .admin-dialog-actions { display: flex; justify-content: flex-end; gap: .6rem; margin-top: 1rem; }
  .admin-dialog-actions button { padding: .65rem 1rem; border: 0; border-radius: 8px; cursor: pointer; font: inherit; }
  #admin-login-submit { background: #159957; color: white; font-weight: 700; }
  #admin-login-message { min-height: 1.3em; margin: .6rem 0 0; color: #a12d2d; font-size: .9rem; }
</style>
