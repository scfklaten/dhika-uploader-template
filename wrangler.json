{
  "name": "dhika-uploader-template",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "GITHUB_OWNER": "scfklaten",
    "GITHUB_REPO": "dhika-uploader-template",
    "GITHUB_BRANCH": "main",
    "IMAGE_DIR": "public/images"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}